{
  "name": "odai-dsh-agent",
  "version": "0.2.15",
  "description": "完整继承 DSH 标准模式 全部能力的 Odai Agent preset。主要用于治理、规划、测试、验证 等，可当成默认总控使用。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orziz/odai.git",
    "directory": "dsh/agent"
  },
  "homepage": "https://github.com/orziz/odai#readme",
  "bugs": {
    "url": "https://github.com/orziz/odai/issues"
  },
  "type": "module",
  "main": "./build/src/installer.mjs",
  "exports": {
    ".": "./build/src/installer.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "odai-dsh-agent": "./build/bin/odai-dsh-agent.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "build/bin",
    "build/src",
    "preset",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:dsh": "npm --prefix ../.. run build:dsh",
    "typecheck:dsh": "npm --prefix ../.. run typecheck:dsh",
    "check": "npm run typecheck:dsh && npm run build:dsh && find ../runtime/build build/bin build/src -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "prepare:artifact": "npm run build:dsh && node ../../scripts/package-odai-artifact.mjs prepare --skill-root preset/odai/skills --runtime-root preset/odai/runtime",
    "clean:artifact": "node ../../scripts/package-odai-artifact.mjs clean --skill-root preset/odai/skills --runtime-root preset/odai/runtime",
    "prepare": "npm run prepare:artifact",
    "verify:version": "node ../../scripts/verify-dsh-package-versions.mjs",
    "prepack": "npm run verify:version && node ../../scripts/validate-odai-skill.mjs",
    "postpack": "npm run clean:artifact",
    "pack:dry-run": "node ../../scripts/run-package-pack.mjs --clean preset/odai/runtime --clean preset/odai/skills -- --dry-run",
    "test": "npm run verify:version && npm run build:dsh && npm --prefix ../.. exec -- tsx --test ./tests/*.test.mts",
    "verify:dsh": "npm run build:dsh && npm --prefix ../.. exec -- tsx ./tests/verify-agent-load.mts"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2 || 0.1.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "agent",
    "deepseek-harness",
    "dsh",
    "odai",
    "preset"
  ]
}
