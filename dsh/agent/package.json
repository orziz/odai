{
  "name": "odai-dsh-agent",
  "version": "0.2.38",
  "description": "独立维护的 odai 治理模式预设（DSH bundle），按任务需要提供治理与协作。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orziz/odai.git",
    "directory": "dsh/agent"
  },
  "homepage": "https://github.com/orziz/odai#readme",
  "bugs": {
    "url": "https://github.com/orziz/odai/issues"
  },
  "type": "module",
  "main": "./build/src/installer.mjs",
  "exports": {
    ".": "./build/src/installer.mjs",
    "./governance": "./preset/odai/odai-governance.mjs",
    "./control-center": "./build/src/control-center-installer.mjs",
    "./control-center-host": "./preset/odai/runtime/control-center-host.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "odai-dsh-agent": "./build/bin/odai-dsh-agent.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "build/bin",
    "build/src",
    "client",
    "preset",
    "preset.cordis.patch.yml",
    "control-center.cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./preset.cordis.patch.yml",
        "./control-center.cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:dsh": "npm --prefix ../.. run build:dsh",
    "typecheck:dsh": "npm --prefix ../.. run typecheck:dsh",
    "check": "npm --prefix ../.. run check:dsh",
    "prepare:artifact": "npm run build:dsh && node ../../scripts/package-odai-artifact.mjs prepare --skill-root preset/odai/skills --runtime-root preset/odai/runtime --client-root client --client-package odai-dsh-agent",
    "clean:artifact": "node ../../scripts/package-odai-artifact.mjs clean --skill-root preset/odai/skills --runtime-root preset/odai/runtime --client-root client --client-package odai-dsh-agent",
    "prepare": "npm run prepare:artifact",
    "verify:version": "node ../../scripts/verify-dsh-package-versions.mjs",
    "prepack": "npm run verify:version && node ../../scripts/validate-odai-skill.mjs",
    "postpack": "npm run clean:artifact",
    "pack:dry-run": "node ../../scripts/run-package-pack.mjs --clean preset/odai/runtime --clean preset/odai/skills --clean client -- --dry-run",
    "test": "npm run verify:version && npm run build:dsh && node --test ./tests/*.test.mjs",
    "verify:dsh": "npm run build:dsh && node ./tests/verify-agent-load.mjs"
  },
  "dependencies": {
    "semver": "^7.8.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "agent",
    "deepseek-harness",
    "dsh",
    "odai",
    "preset"
  ]
}
